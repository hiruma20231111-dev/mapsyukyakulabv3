# マップ集客ラボ v2 — 環境変数（本番は Vercel の Environment Variables に設定）

# 【必須】招待トークンの暗号化キー（AES-256-GCM の鍵の元）。
# 長いランダム文字列にすること。これが変わると発行済み招待リンクは全て無効になる。
# 生成例: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SERVER_SECRET=change-me-to-a-long-random-string

# 【任意・履歴/ダッシュボードを使うなら必須】Upstash/Vercel Redis の接続URL（TCP）。
# 未設定でも診断・相談・ガイドは動く（利用履歴ダッシュボードだけ無効になる）。
# 例: rediss://default:xxxxx@yyyy.upstash.io:6379
REDIS_URL=
